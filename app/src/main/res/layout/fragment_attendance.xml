<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateQR"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:text="TẠO MÃ QR ĐIỂM DANH"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorPrimaryDark"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_share" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanQR"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="QUÉT MÃ QR"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="@color/colorAccent"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_camera" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnterPin"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="NHẬP MÃ PIN BẰNG TAY" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewAttendance"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:text="DANH SÁCH &amp; THỐNG KÊ"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#4CAF50"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_recent_history" />

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LỊCH SỬ CỦA BẠN"
        android:textColor="#003366"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttendanceHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="20dp"/>

</LinearLayout>